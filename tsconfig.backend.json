{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "out/backend"
  },
  "include": ["src/backend/**/*.ts", "src/contracts/learning-api.ts"],
  "exclude": ["src/**/*.test.ts"]
}
