{
  "name": "applied-research",
  "version": "0.1.0",
  "private": true,
  "description": "A learning workbench for builders",
  "author": "Aaryan Das",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaryandas/applied-research.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run native:electron && electron-vite dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.backend.json",
    "test": "npm run native:node && vitest run",
    "test:unit": "vitest run --project unit",
    "test:renderer": "vitest run --project renderer",
    "test:integration": "npm run native:node && vitest run --project integration",
    "test:watch": "npm run native:node && vitest",
    "test:coverage": "npm run native:node && vitest run --coverage",
    "test:e2e": "npm run native:electron && playwright test",
    "build": "electron-vite build && npm run build:backend",
    "test:delivery": "node --test scripts/delivery-trust.test.mjs scripts/delivery-review.test.mjs scripts/delivery-queue.test.mjs scripts/delivery-cursor-api.test.mjs scripts/delivery-workflows.test.mjs scripts/delivery-constants.test.mjs scripts/delivery-github.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:delivery && npm run test:coverage && npm run build",
    "package": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "test:packaged": "node scripts/test-packaged.mjs",
    "sonar:start": "docker compose --env-file .env.sonar -f compose.sonar.yml up -d database sonarqube",
    "sonar:stop": "docker compose --env-file .env.sonar -f compose.sonar.yml stop",
    "sonar:logs": "docker compose --env-file .env.sonar -f compose.sonar.yml logs --tail 100 sonarqube",
    "sonar:scan": "npm run test:coverage && docker compose --env-file .env.sonar -f compose.sonar.yml run --rm scanner",
    "native:node": "npm rebuild better-sqlite3",
    "native:electron": "electron-rebuild -f -w better-sqlite3",
    "dev:backend": "npm run build:backend && npm run start:backend",
    "test:backend:postgres": "vitest run --config vitest.backend-postgres.config.ts",
    "build:backend": "tsc -p tsconfig.backend.json && node scripts/copy-backend-assets.mjs",
    "start:backend": "node --enable-source-maps out/backend/backend/entrypoint.js",
    "migrate:backend": "npm run build:backend && node --enable-source-maps out/backend/backend/migrate.js",
    "migrate:backend:built": "node --enable-source-maps out/backend/backend/migrate.js",
    "sonar:scan:native": "npm run test:coverage && sonar -Dsonar.projectKey=applied-research-local '-Dsonar.projectVersion=not provided' -Dsonar.scm.disabled=true -Dsonar.qualitygate.wait=true -Dsonar.typescript.tsconfigPaths=tsconfig.node.json,tsconfig.web.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@better-auth/electron": "1.7.3",
    "@react-three/fiber": "9.7.0",
    "@xyflow/react": "12.11.6",
    "better-auth": "1.7.3",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.1",
    "parse5": "8.0.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sonar/scan": "5.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "minimatch": "10.2.6",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
